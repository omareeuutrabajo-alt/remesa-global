{
  "name": "remesas-auth-api",
  "version": "1.0.0",
  "private": true,
  "description": "API de autenticación, OTP, PIN, biometría y KYC para app de remesas",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "db:local": "bash scripts/postgres-local.sh",
    "test": "node tests/almacenamiento.test.js && node tests/serverless.test.js",
    "test:e2e": "node tests/e2e.test.js",
    "test:serverless": "node tests/serverless.test.js",
    "test:storage": "node tests/almacenamiento.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  }
}
